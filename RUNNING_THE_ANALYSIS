11. SPLIT THE ML-SELECTED HELD-OUT EVENTS BACK INTO FOUR DATASETS
----------------------------------------------------------------------

The combined "generic" feature table intentionally does not contain a
dataset-label feature. Dataset bookkeeping information was removed so
that the ML model could not learn simulation-dataset identity as a
shortcut.

The combined event IDs retain separated event-number blocks, which can
be used after model application to recover the four dataset groups.

Run:

    python3 - <<'PY'
    import os
    import numpy as np
    import pandas as pd

    inp = (
        "simulated_data/simulated_data_analysis/"
        "test30_model_application/"
        "static_candidate_selected_by_model.csv"
    )

    outdir = "simulated_data/simulated_data_analysis"

    names = [
        "alpha_300",
        "alpha_400",
        "alpha_580",
        "proton_500",
    ]

    d = pd.read_csv(inp)

    events = np.array(sorted(d["event"].astype(int).unique()))

    if len(events) == 0:
        raise RuntimeError("No events found.")

    gaps = np.diff(events)

    if len(gaps) < 3:
        raise RuntimeError(
            "Not enough events to identify four datasets."
        )

    cut_indices = np.argsort(gaps)[-3:]
    cut_indices = sorted(cut_indices)

    blocks = np.split(
        events,
        [i + 1 for i in cut_indices]
    )

    if len(blocks) != 4:
        raise RuntimeError(
            "Expected four event-ID blocks, got %d" % len(blocks)
        )

    print("")
    print("Detected dataset blocks:")

    for name, block in zip(names, blocks):
        event_set = set(int(x) for x in block)

        sub = d[
            d["event"].astype(int).isin(event_set)
        ].copy()

        outfile = os.path.join(
            outdir,
            name + "_selected.csv"
        )

        sub.to_csv(outfile, index=False)

        print(
            "%-12s events=%5d rows=%5d range=%d..%d -> %s"
            % (
                name,
                len(event_set),
                len(sub),
                int(block.min()),
                int(block.max()),
                outfile,
            )
        )
    PY

This generates:

    simulated_data/simulated_data_analysis/
        alpha_300_selected.csv
        alpha_400_selected.csv
        alpha_580_selected.csv
        proton_500_selected.csv

Each file should contain 2,640 selected events.

